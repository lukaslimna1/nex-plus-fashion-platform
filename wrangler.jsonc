{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nex-plus-fashion",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "apps/web/dist",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nex-plus-fashion",
      "database_id": "1325ad95-daf7-44ae-8f68-02bcba20839a",
      "migrations_dir": "migrations"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "APP_ENV": "local",
    "WORKER_VERSION": "0.1.0",
    "CORS_ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173",
    "GEMINI_MODEL": "gemini-3.8-flash"
  },
  "env": {
    "preview": {
      "name": "nex-plus-fashion-preview",
      "vars": {
        "APP_ENV": "preview",
        "WORKER_VERSION": "0.1.0",
        "CORS_ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173",
        "GEMINI_MODEL": "gemini-3.8-flash"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "nex-plus-fashion",
          "database_id": "1325ad95-daf7-44ae-8f68-02bcba20839a",
          "migrations_dir": "migrations"
        }
      ],
      "ai": { "binding": "AI" }
    },
    "production": {
      "name": "nex-plus-fashion",
      "vars": {
        "APP_ENV": "production",
        "WORKER_VERSION": "0.1.0",
        "CORS_ALLOWED_ORIGINS": "",
        "GEMINI_MODEL": "gemini-3.8-flash"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "nex-plus-fashion",
          "database_id": "1325ad95-daf7-44ae-8f68-02bcba20839a",
          "migrations_dir": "migrations"
        }
      ],
      "ai": { "binding": "AI" }
    }
  }
}
