{
  "name": "nex-plus-fashion-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev:worker",
    "dev:web": "npm --workspace @nex-plus/web run dev",
    "dev:worker": "wrangler dev",
    "build": "npm run typecheck && npm --workspace @nex-plus/worker run build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "lint": "tsc -b --pretty false",
    "deploy": "wrangler deploy --env production",
    "deploy:preview": "wrangler deploy --env preview",
    "db:migrate:local": "wrangler d1 migrations apply nex-plus-fashion --local",
    "db:migrate:remote": "wrangler d1 migrations apply nex-plus-fashion --remote",
    "cf:typegen": "wrangler types",
    "verify:infra": "tsx scripts/verify-infra.ts",
    "verify:ai": "tsx scripts/verify-ai.ts",
    "import:route-global": "tsx scripts/import-route-global.ts",
    "ingest:pfw:ss27": "tsx scripts/generate-pfw-ss27-seed.ts"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "cheerio": "^1.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.3",
    "@cloudflare/workers-types": "^5.20260930.2",
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.145.0"
  }
}
