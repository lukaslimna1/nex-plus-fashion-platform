{
  "name": "@nex-plus/fashion-desktop",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/desktop",
    "packages/contracts"
  ],
  "scripts": {
    "build": "npm run build:contracts && npm run build:desktop",
    "build:contracts": "npm run build --workspace @nex-plus/contracts",
    "build:desktop": "npm run build --workspace @nex-plus/desktop",
    "test": "npm run build:contracts && npm run test --workspace @nex-plus/contracts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "tauri:dev": "tauri dev --config src-tauri/tauri.conf.json",
    "tauri:build": "tauri build --config src-tauri/tauri.conf.json"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.1"
  }
}
