{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@nex-plus/types": ["./packages/types/src/index.ts"],
      "@nex-plus/core": ["./packages/core/src/index.ts"],
      "@nex-plus/data": ["./packages/data/src/index.ts"],
      "@nex-plus/media": ["./packages/media/src/index.ts"],
      "@nex-plus/ui": ["./packages/ui/src/index.ts"]
    }
  },
  "include": [
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "apps/worker/**/*.ts",
    "apps/web/**/*.ts",
    "apps/web/**/*.tsx",
    "scripts/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
