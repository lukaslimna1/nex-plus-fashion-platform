{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NEX+ Fashion",
  "version": "0.1.0",
  "identifier": "com.nexplus.fashion",
  "build": {
    "beforeDevCommand": "npm run dev --workspace @nex-plus/desktop",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../apps/desktop/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NEX+ Fashion",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
